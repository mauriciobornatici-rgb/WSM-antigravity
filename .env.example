# ==============================================================================
# WSM SportsERP — Plantilla Canónica de Variables de Entorno (.env.example)
# ==============================================================================
# Copia este archivo a `.env` (desarrollo local) o a `.env.staging` / `.env.production`
# NUNCA confirmes archivos `.env` reales con secretos al repositorio.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configuración General del Runtime
# ------------------------------------------------------------------------------
# Entorno de ejecución: development | staging | production
NODE_ENV=development

# Puerto del servidor backend Express
PORT=3001

# URL base pública del frontend (utilizada para validar CORS y generación de enlaces)
# En staging/producción DEBE ser HTTPS (ej. https://erp.tucomercio.com)
APP_BASE_URL=http://localhost:5173

# URL de la API consumida por el cliente Vite durante el build/dev
VITE_API_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# 2. Base de Datos MySQL
# ------------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=wsm_user
DB_PASSWORD=wsm_secure_password_here
DB_NAME=wsm_sports_erp

# Conexión cifrada TLS/SSL para la base de datos:
# En desarrollo puede ser false si MySQL es local.
# En staging/production DEBE ser true y REJECT_UNAUTHORIZED debe ser true.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Bandera de contingencia para pruebas internas no productivas (dejar en false en prod)
ALLOW_INSECURE_NON_DEV=false

# ------------------------------------------------------------------------------
# 3. Seguridad y Autenticación JWT
# ------------------------------------------------------------------------------
# Secreto para firmar tokens JWT (mínimo 32 caracteres criptográficamente seguros)
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_for_security

# Tiempo de expiración de sesión JWT (ej. 8h, 1d, 12h)
JWT_EXPIRES_IN=8h

# Clave simétrica de 32 bytes (64 caracteres hex) para cifrado AES-256-GCM en reposo
# Utilizada para proteger certificados AFIP/ARCA y tokens OAuth de Tiendanube en la tabla `settings`.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ------------------------------------------------------------------------------
# 4. Políticas de Red, CORS y Proxy Reverso
# ------------------------------------------------------------------------------
# Orígenes permitidos separados por coma.
# En staging/producción NO se permiten comodines (*) ni orígenes localhost.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Confianza en encabezados de proxy reverso (Nginx, Traefik, Cloudflare, etc.)
# Habilita lectura correcta de X-Forwarded-For y protocolo HTTPS.
# Valores: true | false | número de saltos (ej. 1)
TRUST_PROXY=false

# ------------------------------------------------------------------------------
# 5. Rate Limiting y Protección contra Abuso
# ------------------------------------------------------------------------------
# Ventana y límite para autenticación (/api/login)
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=8

# Ventana y límite general para la API
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=1200

# ------------------------------------------------------------------------------
# 6. Integraciones Externas
# ------------------------------------------------------------------------------
# URL pública para recepción de webhooks de Tiendanube (debe ser HTTPS en staging/prod)
# Ejemplo: https://api.tucomercio.com/api/integrations/tiendanube/webhooks
TIENDANUBE_WEBHOOK_URL=
